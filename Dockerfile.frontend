# ─── Frontend: Vite build + Nginx (проксирование /api → backend) ────

# Stage 1: Build
FROM node:22-alpine AS builder
WORKDIR /app

COPY package.json package-lock.json* bun.lock* ./
RUN npm ci --ignore-scripts

COPY . .

ARG VITE_API_URL=/api
ARG VITE_YANDEX_MAPS_KEY
ARG VITE_YANDEX_MAPS_GEOCODER_KEY
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_YANDEX_MAPS_KEY=${VITE_YANDEX_MAPS_KEY}
ENV VITE_YANDEX_MAPS_GEOCODER_KEY=${VITE_YANDEX_MAPS_GEOCODER_KEY}
RUN npm run build

# Stage 2: Nginx (статика + прокси /api)
FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
